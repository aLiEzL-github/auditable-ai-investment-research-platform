# .env.example —— 环境变量模板（G1-05）
# ⚠️ 本文件**只含键名与占位说明，不得出现任何真实值**
# （附加验收 1b：本文件须通过 secret_scan）

# 应用
APP_PORT=8080
# 本地默认只绑定 loopback；容器场景须显式设为 0.0.0.0（见 Dockerfile CMD）
BIND_HOST=127.0.0.1
LOG_LEVEL=INFO

# 数据库（本机 SQLite 场景可不设 DATABASE_URL，用默认路径）
# DATABASE_URL=<数据库连接串，含口令时仅从本机环境注入，禁止写入本文件>

# 密钥类配置 —— 一律只从运行环境注入，不写入版本控制
# DATABASE_PASSWORD=<仅本机环境变量>
# SESSION_TOKEN_TTL=3600
