{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "errors.json 元模式（H-4/J3）",
  "type": "object",
  "required": ["schema_version", "codes"],
  "properties": {
    "schema_version": {"type": "string"},
    "namespaces": {"type": "object"},
    "codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "pattern": "^E-[A-Z]+-[0-9]{3}$"},
          "message": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
