{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_version": "1.0",
  "title": "claim_evidence_link canonical schema",
  "description": "G2-01 ClaimEvidenceLink：证据与 Claim 的多对多支持/反驳关系",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "evidence_id",
    "direction"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_\\-]{2,63}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_\\-]{2,63}$"
    },
    "direction": {
      "enum": [
        "SUPPORT",
        "REFUTE"
      ]
    }
  }
}
