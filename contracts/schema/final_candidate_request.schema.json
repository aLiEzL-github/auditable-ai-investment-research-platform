{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_version": "1.0.0",
  "title": "G6A-06 final candidate freeze request",
  "description": "本地最终候选冻结请求；approved snapshot 只能由 proposals 与 decisions 重建。",
  "type": "object",
  "required": ["schema_version", "run_id", "context"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "required": [
        "contract",
        "facts",
        "macro",
        "formula_specs",
        "valuation_inputs",
        "assumption_defaults",
        "approved_snapshot",
        "open_items_policy"
      ],
      "properties": {
        "contract": {"type": "object"},
        "facts": {"type": "object"},
        "macro": {"type": "object"},
        "formula_specs": {"type": "object"},
        "assumption_defaults": {"type": "object"},
        "valuation_inputs": {
          "type": "object",
          "required": ["scope", "currency", "as_of"],
          "properties": {
            "scope": {"type": "string", "minLength": 1},
            "currency": {"type": "string", "minLength": 1},
            "as_of": {"type": "string", "minLength": 1},
            "price": {"type": "string"},
            "shares_outstanding": {"type": "string"},
            "net_debt": {"type": "string"},
            "minority_interest": {"type": "string"},
            "industry_commodity": {"type": "string"},
            "statuses": {"type": "object"}
          },
          "additionalProperties": false
        },
        "approved_snapshot": {
          "type": "object",
          "required": ["snapshot_id", "version", "proposals", "decisions"],
          "properties": {
            "snapshot_id": {"type": "string", "minLength": 1},
            "version": {"type": "integer", "minimum": 1},
            "proposals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["proposal_id", "payload", "proposed_by"],
                "properties": {
                  "proposal_id": {"type": "string", "minLength": 1},
                  "payload": {"type": "object"},
                  "proposed_by": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            },
            "decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "proposal_id", "decision", "approver", "decided_at", "token"
                ],
                "properties": {
                  "proposal_id": {"type": "string", "minLength": 1},
                  "decision": {"enum": ["APPROVED", "REJECTED"]},
                  "approver": {"type": "string", "minLength": 1},
                  "decided_at": {"type": "string", "minLength": 1},
                  "token": {"type": "string", "minLength": 1},
                  "rejection_reason": {"type": "string"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "open_items_policy": {
          "type": "object",
          "required": ["tolerance", "owner_role", "due_date", "blocks_gate"],
          "properties": {
            "tolerance": {"type": "string", "minLength": 1},
            "owner_role": {"type": "string", "minLength": 1},
            "due_date": {"type": "string", "minLength": 1},
            "blocks_gate": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
