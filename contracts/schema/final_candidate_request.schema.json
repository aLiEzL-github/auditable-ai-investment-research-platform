{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_version": "1.1.0",
  "title": "G6A-06 final candidate freeze request",
  "description": "本地最终候选冻结请求；approved snapshot 只能由 proposals 与 decisions 重建。valuation_routes 声明四路估值（fcff/fcfe/relative/pe_roe_pb）的状态，状态专属字段条件由契约 oneOf 表达（不靠 app 代码）：READY 不得带 reason/evidence_refs/missing_inputs；INPUT_MISSING 必须带非空 reason+evidence_refs+missing_inputs；NOT_EVALUATED 必须带非空 reason+evidence_refs 且不得带 missing_inputs。",
  "definitions": {
    "route_decl": {
      "type": "object",
      "oneOf": [
        {
          "description": "READY：该路已完成评估，不得携带任何非 READY 元数据。",
          "properties": {
            "state": {"const": "READY"}
          },
          "required": ["state"],
          "additionalProperties": false
        },
        {
          "description": "INPUT_MISSING：缺输入，须带非空 reason + 非空证据引用 + 非空 missing_inputs。",
          "properties": {
            "state": {"const": "INPUT_MISSING"},
            "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
            },
            "missing_inputs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          },
          "required": ["state", "reason", "evidence_refs", "missing_inputs"],
          "additionalProperties": false
        },
        {
          "description": "NOT_EVALUATED：未评估，须带非空 reason + 非空证据引用，且不得带 missing_inputs。",
          "properties": {
            "state": {"const": "NOT_EVALUATED"},
            "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          },
          "required": ["state", "reason", "evidence_refs"],
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": ["schema_version", "run_id", "source_revision", "context"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source_revision": {
      "description": "请求声明的期望代码版本：冻结时须与显式干净 checkout 提供的 source_commit/source_tree 逐字一致；候选根取同一值，复验时绑定请求 revision 必须与候选一致。",
      "type": "object",
      "required": ["source_commit", "source_tree"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "contract",
        "facts",
        "macro",
        "formula_specs",
        "valuation_inputs",
        "assumption_defaults",
        "approved_snapshot",
        "open_items_policy",
        "valuation_routes"
      ],
      "properties": {
        "contract": {"type": "object"},
        "facts": {"type": "object"},
        "macro": {"type": "object"},
        "formula_specs": {"type": "object"},
        "assumption_defaults": {"type": "object"},
        "valuation_inputs": {
          "type": "object",
          "required": ["scope", "currency", "as_of"],
          "properties": {
            "scope": {"type": "string", "minLength": 1},
            "currency": {"type": "string", "minLength": 1},
            "as_of": {"type": "string", "minLength": 1},
            "price": {"type": "string"},
            "shares_outstanding": {"type": "string"},
            "net_debt": {"type": "string"},
            "minority_interest": {"type": "string"},
            "industry_commodity": {"type": "string"},
            "statuses": {"type": "object"}
          },
          "additionalProperties": false
        },
        "valuation_routes": {
          "type": "object",
          "required": ["fcff", "fcfe", "relative", "pe_roe_pb"],
          "properties": {
            "fcff": {"$ref": "#/definitions/route_decl"},
            "fcfe": {"$ref": "#/definitions/route_decl"},
            "relative": {"$ref": "#/definitions/route_decl"},
            "pe_roe_pb": {"$ref": "#/definitions/route_decl"}
          },
          "additionalProperties": false
        },
        "approved_snapshot": {
          "type": "object",
          "required": ["snapshot_id", "version", "proposals", "decisions"],
          "properties": {
            "snapshot_id": {"type": "string", "minLength": 1},
            "version": {"type": "integer", "minimum": 1},
            "proposals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["proposal_id", "payload", "proposed_by"],
                "properties": {
                  "proposal_id": {"type": "string", "minLength": 1},
                  "payload": {"type": "object"},
                  "proposed_by": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            },
            "decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "proposal_id", "decision", "approver", "decided_at", "token"
                ],
                "properties": {
                  "proposal_id": {"type": "string", "minLength": 1},
                  "decision": {"enum": ["APPROVED", "REJECTED"]},
                  "approver": {"type": "string", "minLength": 1},
                  "decided_at": {"type": "string", "minLength": 1},
                  "token": {"type": "string", "minLength": 1},
                  "rejection_reason": {"type": "string"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "open_items_policy": {
          "type": "object",
          "required": ["tolerance", "owner_role", "due_date", "blocks_gate"],
          "properties": {
            "tolerance": {"type": "string", "minLength": 1},
            "owner_role": {"type": "string", "minLength": 1},
            "due_date": {"type": "string", "minLength": 1},
            "blocks_gate": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
