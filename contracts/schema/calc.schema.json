{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "schema_version": "1.0.0",
 "title": "calc canonical schema",
 "description": "计算记录（输入必须是已冻结对象，M2）",
 "type": "object",
 "required": [
  "id",
  "schema_version",
  "snapshot_id",
  "formula",
  "inputs",
  "output",
  "unit",
  "calc_engine_version"
 ],
 "properties": {
  "schema_version": {
   "type": "string"
  },
  "id": {
   "type": "string",
   "pattern": "^[A-Z0-9][A-Z0-9_\\-]{2,63}$"
  },
  "snapshot_id": {
   "type": "string",
   "pattern": "^[A-Z0-9][A-Z0-9_\\-]{2,63}$"
  },
  "formula": {
   "type": "string",
   "minLength": 1
  },
  "inputs": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[A-Z0-9][A-Z0-9_\\-]{2,63}$"
   },
   "minItems": 1
  },
  "output": {
   "type": "string",
   "pattern": "^-?\\d+(\\.\\d+)?$"
  },
  "unit": {
   "type": "string"
  },
  "calc_engine_version": {
   "type": "string"
  },
  "check": {
   "type": "object"
  }
 },
 "additionalProperties": false
}
