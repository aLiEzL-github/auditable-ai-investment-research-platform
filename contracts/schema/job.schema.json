{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "schema_version": "1.0.0",
 "title": "job canonical schema",
 "description": "Job 队列记录（G1-04：租约/幂等/取消/恢复）",
 "type": "object",
 "required": [
  "id",
  "schema_version",
  "job_key",
  "status"
 ],
 "properties": {
  "schema_version": {
   "type": "string"
  },
  "id": {
   "type": "integer",
   "minimum": 1
  },
  "job_key": {
   "type": "string",
   "minLength": 1
  },
  "payload": {
   "type": "string"
  },
  "status": {
   "enum": [
    "PENDING",
    "RUNNING",
    "DONE",
    "FAILED",
    "CANCELLED"
   ]
  },
  "worker_id": {
   "type": "string"
  },
  "lease_until": {
   "type": "string"
  },
  "attempts": {
   "type": "integer",
   "minimum": 0
  },
  "result": {
   "type": "string"
  },
  "error": {
   "type": "string"
  },
  "created_at": {
   "type": "string"
  },
  "updated_at": {
   "type": "string"
  },
  "version": {
   "type": "integer",
   "minimum": 1
  }
 },
 "additionalProperties": false
}
